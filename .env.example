# Every variable here is REQUIRED — the app validates them at boot (Zod) and refuses to start if any is
# missing or malformed. There are no silent fallbacks. Copy to .env (or .env.local) and fill in.
#
# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cue
DB_PASSWORD=cue
DB_DATABASE=cue
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
DB_LOGGING=true
# `true` maps to ssl:{rejectUnauthorized:false} — i.e. NEGOTIATE SSL but skip cert
# verification. That is for a remote/managed Postgres (e.g. RDS) that REQUIRES SSL.
# The LOCAL docker postgres:15-alpine has SSL compiled OFF and refuses the handshake
# ("The server does not support SSL connections"), so local dev needs `false` (no
# `ssl` key is set → plaintext connection). Prod sets `true` via its own env/SSM.
DB_DISABLE_SSL_AUTH=false

# Redis Configuration
# Backs the assistant: BullMQ webhook queue, dedupe set, link nonces, held-conflict writes.
REDIS_HOST=localhost
REDIS_PORT=6379
# Required (every var is). Leave the value empty for a password-less local Redis.
REDIS_PASSWORD=
REDIS_DB=0

# Auth Configuration
# JWT_SECRET must be at least 32 chars — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=30d
# Apple Services ID / bundle ID that signed the identity token; must match the iOS app bundle.
APPLE_CLIENT_ID=makarov.cue

# External Messaging Vendor (Telegram)
# Read by the external-vendor connector.
EXTERNAL_VENDOR=telegram
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Shared secret sent in the X-Telegram-Bot-Api-Secret-Token header; authenticates inbound webhooks.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org

# AI Provider (Anthropic)
# Read by the AI connector.
ASSISTANT_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Main = Sonnet (reasoning + tool use); Background = Haiku (summaries, memory, triage). See docs/adr/0003.
# Replace with the current model IDs from https://docs.anthropic.com/en/docs/about-claude/models
ASSISTANT_MODEL_MAIN=claude-sonnet-4-5
ASSISTANT_MODEL_BACKGROUND=claude-haiku-4-5
ASSISTANT_MAX_OUTPUT_TOKENS=1024
# Bounded transport retries handed to the Anthropic SDK.
ASSISTANT_AI_MAX_RETRIES=2

# Speech-to-Text (OpenAI)
# Read by the STT connector; transcribes Telegram voice notes (OGG/Opus, transcoded to WAV before upload).
STT_PROVIDER=openai
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
# Translate transcripts to English (off by default — Claude is multilingual, we keep the source language).
STT_TRANSLATE_TO_ENGLISH=false

# Assistant Orchestration
# Public HTTPS base the app registers the Telegram webhook against on boot (appends /assistant/telegram/webhook).
# A bad/unreachable value only fails registration (logged, non-fatal) — locally point it at your tunnel (e.g. ngrok).
ASSISTANT_WEBHOOK_URL=https://cue.ngrok.app
# Public HTTPS base for the iOS universal link in the linking prompt; must match the app's Associated Domains.
ASSISTANT_APP_LINK_BASE_URL=https://cue.ngrok.app
# Overall tool-use round-trip ceiling per turn.
ASSISTANT_MAX_TOOL_ROUNDTRIPS=8
# Per-turn cap on schedule-read tool calls.
ASSISTANT_MAX_SCHEDULE_FETCHES=5
# Narration re-drive budget (ADR 0009): max corrective re-invocations when the model
# narrates a write but calls no tools. Must be strictly < ASSISTANT_MAX_TOOL_ROUNDTRIPS.
# 0 = kill-switch (revert to detect-and-mask). Default 5.
ASSISTANT_MAX_CORRECTIONS=5
# TTL (seconds) for a held overlapping create/update awaiting user confirmation.
ASSISTANT_HELD_CONFLICT_TTL_SECONDS=600
# ask_user (ADR 0010) hot Redis index TTL — the free-text answer window (30 min).
ASSISTANT_ASK_USER_TTL_SECONDS=1800
# ask_user durable retention (hours): a button answer resumes from Postgres up to
# this horizon even after the Redis TTL / a restart (default 7 days).
ASSISTANT_ASK_USER_RETENTION_HOURS=168
# TTL (seconds) for the live-status handle (StatusSession, ADR 0012) — the
# per-chat/turn pointer to the animated status surface; only needs to outlive one
# in-flight turn (cleared on finalize).
ASSISTANT_STATUS_SESSION_TTL_SECONDS=120
# Live-status animation cadence (Story 12, ADR 0012): trailing-dot tick (ms) and
# loading-word swap (ms). Both routed through the central ~2–5/s draft throttle;
# keep the dot tick at/above ~250 ms so the combined rate stays under the cap.
ASSISTANT_STATUS_DOT_INTERVAL_MS=500
ASSISTANT_STATUS_WORD_INTERVAL_MS=5000
# Per-user serialization lock (Story 11, ADR 0039): auto-expiry TTL (ms) — the
# deadlock backstop a crashed holder relies on — and the watchdog renew interval
# (ms), which MUST stay strictly below the TTL.
ASSISTANT_USER_LOCK_TTL_MS=30000
ASSISTANT_USER_LOCK_RENEW_MS=10000
# Inbound debounce (Story 14a, ADR 0042). WINDOW_MS (~2000) is how long a fresh
# simple message waits before its turn runs; each new inbound re-arms it and is
# combined by concatenation in arrival order. QUEUE_AFTER_MS is the short re-arm
# delay used when a drain finds the per-user lock held (a turn in flight) so the
# drained batch runs AFTER it — keep it well below ASSISTANT_USER_LOCK_TTL_MS.
ASSISTANT_DEBOUNCE_WINDOW_MS=2000
ASSISTANT_DEBOUNCE_QUEUE_AFTER_MS=750
# Cooperative STOP flag TTL (seconds, Story 14b / ADR 0043): how long a user's
# STOP tap stays armed in Redis. The tool loop checks it between rounds + after
# each committed write and the turn clears its own key on exit, so it only needs
# to outlive one in-flight turn — keep it a short, generous multiple of the lock
# TTL so a STOP tapped just before a checkpoint is never missed.
ASSISTANT_STOP_FLAG_TTL_SECONDS=300
# TTL (seconds) for a single-use account-linking nonce.
ASSISTANT_LINK_NONCE_TTL_SECONDS=600
# TTL (seconds) for the inbound-update dedupe guard (at-least-once delivery).
ASSISTANT_DEDUPE_TTL_SECONDS=3600
# Number of recent messages kept verbatim in the prompt window (ADR 0005 tier 1).
ASSISTANT_RECENT_WINDOW_SIZE=10
# How many days ahead to preload schedule context.
ASSISTANT_PRELOAD_HORIZON_DAYS=7
# Message count at which the live window is re-summarized.
ASSISTANT_SUMMARIZE_THRESHOLD=20
