# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cue
DB_PASSWORD=cue
DB_DATABASE=cue
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
DB_LOGGING=true
DB_DISABLE_SSL_AUTH=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth Configuration
# JWT_SECRET must be at least 32 chars — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=30d
# Apple Services ID / bundle ID that signed the identity token; must match the iOS app bundle.
APPLE_CLIENT_ID=makarov.cue
