#!/bin/bash
# Bootstraps the cue-api host: Docker + Compose + AWS CLI, and lays down /opt/cue.
# Runs once at first boot. Output: /var/log/cue-userdata.log
set -euxo pipefail
exec > /var/log/cue-userdata.log 2>&1

# --- Docker ---
dnf -y install docker
systemctl enable --now docker
usermod -aG docker ec2-user

# --- Docker Compose v2 plugin ---
mkdir -p /usr/libexec/docker/cli-plugins
curl -sSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# --- AWS CLI v2 ---
dnf -y install unzip
curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install

# --- App files (base64-decoded from the repo) ---
mkdir -p /opt/cue/origin
echo "${compose_b64}" | base64 -d > /opt/cue/docker-compose.prod.yml
echo "${caddy_b64}"   | base64 -d > /opt/cue/Caddyfile
echo "${deploy_b64}"  | base64 -d > /opt/cue/deploy.sh
chmod +x /opt/cue/deploy.sh

# --- Compose interpolation vars (docker compose auto-reads /opt/cue/.env) ---
# CUE_DOMAIN feeds the Caddy site address; CUE_IMAGE is exported by deploy.sh at deploy time.
printf 'CUE_DOMAIN=%s\n' "${api_hostname}" > /opt/cue/.env

# --- First-boot self-heal: bring the stack up at the last successfully deployed image ---
# deploy.sh records the green tag at ${ssm_prefix}/CURRENT_IMAGE_TAG. On a replaced instance,
# redeploy it so the box self-recovers without waiting for a CI/manual deploy. If no tag is
# recorded yet (very first instance, before any deploy), skip — the first deploy will set it.
TAG="$(aws ssm get-parameter --region "${region}" --name "${ssm_prefix}/CURRENT_IMAGE_TAG" \
  --query 'Parameter.Value' --output text 2>/dev/null || true)"
if [ -n "$${TAG}" ] && [ "$${TAG}" != "None" ]; then
  echo "self-heal: deploying recorded image tag $${TAG}"
  AWS_REGION="${region}" ECR_REGISTRY="${ecr_registry}" ECR_REPO="${ecr_repo}" \
    /opt/cue/deploy.sh "$${TAG}" || echo "self-heal deploy failed; a CI/manual deploy will recover"
else
  echo "self-heal: no CURRENT_IMAGE_TAG recorded yet — skipping (first deploy will set it)"
fi

echo "cue-api host bootstrap complete"